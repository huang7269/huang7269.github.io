---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { collectTags, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`标签：${tag}`} description={`所有标记为 ${tag} 的文章`}>
  <header class="page-header">
    <h1>#{tag}</h1>
    <p>{posts.length} 篇文章</p>
  </header>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <p style="padding-block:2rem"><a href="/tags/" style="font-size:.875rem">← 全部标签</a></p>
</BaseLayout>
